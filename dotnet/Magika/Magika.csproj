<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Magika</RootNamespace>
        <Version>1.0.0</Version>
        <!--<Authors>Google</Authors>-->
        <Description>File type detection using deep learning. A .NET port of Google's Magika.</Description>
        <PackageTags>file-detection;mime-type;onnx;machine-learning;magika</PackageTags>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <!--<RepositoryUrl>https://github.com/google/magika</RepositoryUrl>-->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    </ItemGroup>

</Project>